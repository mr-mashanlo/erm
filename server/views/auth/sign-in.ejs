<!DOCTYPE html>

<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <title>Sign in</title>
    <meta name="title" content="Sign in">
    <meta name="description" content="">
    <meta property="og:type" content="website">
    <meta property="og:title" content="">
    <meta property="og:description" content="">
    <meta property="og:image" content="">
    <meta property="og:url" content="">
    <meta name="twitter:image" content="">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/images/favicon.svg" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon.svg">
    <link rel="stylesheet" href="/sources/main.css">
    <script src="/assets/main.js" defer></script>
  </head>

  <body class="text-xs text-zinc-700 bg-zinc-50">
    <main class="min-h-screen flex items-center justify-center">
      <section>
        <h1 class="mb-5 text-xl text-center font-bold">Sign in</h1>
        <form method="post" id="auth-form" class="w-full sm:w-80">
          <div class="grid gap-4 sm:gap-6 relative">
            <div class="relative">
              <label for="email" class="sr-only">Email</label>
              <input id="email" name="email" type="email" value="<%= body?.email %>" placeholder="jane@mail.com" class="peer w-full p-4 pl-11 rounded-xl bg-zinc-100 placeholder:text-zinc-300" required />
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 absolute top-1/2 left-4.5 -translate-y-1/2 stroke-zinc-300 peer-focus-visible:stroke-zinc-700">
                <circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>
              </svg>
            </div>
            <div class="relative">
              <label for="password" class="sr-only">Password</label>
              <input id="password" name="password" type="password" value="<%= body?.password %>" minlength="8" placeholder="··········" class="peer w-full p-4 pl-11 rounded-xl bg-zinc-100 placeholder:text-zinc-300 focus:bg-transparent data-[error=true]:outline-rose-500" required />
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 absolute top-1/2 left-4.5 -translate-y-1/2 stroke-zinc-300 peer-focus-visible:stroke-zinc-700">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </div>
            <div>
              <button type="submit" class="w-full p-4 rounded-xl bg-black text-white cursor-pointer outline-offset-3 disabled:cursor-default disabled:opacity-70">Sign in</button>
            </div>
            <div class="text-center">
              <% if ( errors.length ) { %>
                <p><%= errors.map( error => error.message ).join(', ') %>. <a href="/signup" class="font-bold hover:underline">Register</a></p>
              <% } else { %>
                <p>Don't have an account? <a href="/signup" class="font-bold hover:underline">Register</a></p>
              <% } %>
            </div>
          </div>
        </form>
      </section>
    </main>
  </body>

</html>