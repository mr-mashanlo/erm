<%
  const page = companies.page;
  const total = companies.total || 1;
  const limit = companies.limit;

  const paginationItems = 3;
  const paginationTotal = Math.ceil( total / limit );
  const coefficient = Math.ceil( page / paginationItems );
  const start = coefficient * paginationItems - paginationItems;
  const end = coefficient * paginationItems;
%>

<!DOCTYPE html>

<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <title>Companies</title>
    <meta name="title" content="Companies">
    <meta name="description" content="">
    <meta property="og:type" content="website">
    <meta property="og:title" content="">
    <meta property="og:description" content="">
    <meta property="og:image" content="">
    <meta property="og:url" content="">
    <meta name="twitter:image" content="">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/images/favicon.svg" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon.svg">
    <link rel="stylesheet" href="/assets/main.css">
    <script src="/assets/main.js" defer></script>
  </head>

  <body class="text-xs text-zinc-700 bg-zinc-50">
    <%- include( '../shared/header' ); %>
    <main>
      <section class="mx-4 my-8 sm:mx-10 sm:my-20">
        <h1 class="mb-3 text-xl sm:text-2xl font-semibold">Companies</h1>
        <p class="max-w-2xl leading-[200%]">At tempore commodi quibusdam sed ea veritatis temporibus accusantium qui corporis obcaecati aperiam, eveniet, quisquam recusandae magni ducimus error possimus.</p>
      </section>
      <section class="m-4 sm:m-10">
        <div class="border border-zinc-200 rounded-md">
          <div class="border-b border-zinc-200">
            <div class="flex items-center">
              <div class="p-3">
                <button onclick="create_modal.showModal()" class="w-7.5 h-7.5 shrink-0 flex items-center justify-center text-center bg-zinc-100 rounded-md cursor-pointer">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                    <path d="M5 12h14"/><path d="M12 5v14"/>
                  </svg>
                </button>
                <dialog id="create_modal" class="modal">
                  <div class="modal-box min-w-3xl py-35 bg-zinc-50">
                    <h3 class="mb-5 text-xl text-center font-bold">Create company</h3>
                    <%- include( 'create-form' ); %>
                  </div>
                  <form method="dialog" class="modal-backdrop">
                    <button>close</button>
                  </form>
                </dialog>
              </div>
              <div class="p-3">
                <h2 class="font-bold">Companies</h2>
              </div>
            </div>
          </div>
          <div class="overflow-auto">
            <table class="w-full min-w-200 text-left table-fixed">
              <thead>
                <tr>
                  <th class="w-13.5 h-13.5"></th>
                  <th class="p-3">
                    <a href="<%= buildUrl( { sort: 'name', order: query.order === 'asc' ? 'desc' : 'asc' } ) %>" class="inline-flex items-center gap-1 cursor-pointer">
                      <span>Name</span>
                      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                        <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                      </svg>
                    </a>
                  </th>
                </tr>
              </thead>
              <tbody>
                <% companies.data.forEach( company => { %>
                  <tr class="border-t border-zinc-200">
                    <td class="w-13.5 h-13.5 p-3">
                      <button class="w-7.5 h-7.5 shrink-0 flex items-center justify-center text-center border border-none rounded-md cursor-pointer hover:bg-zinc-100" popovertarget="popover-<%= company.id %>" style="anchor-name:--anchor-<%= company.id %>">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                      </button>
                      <ul id="popover-<%= company.id %>" class="dropdown w-52 mt-1 rounded-box bg-base-100 border border-zinc-200" popover style="position-anchor:--anchor-<%= company.id %>">
                        <li>
                          <button class="w-full p-2.5 text-left cursor-pointer">Edit</button>
                        </li>
                        <li class="border-t border-zinc-200">
                          <button class="w-full p-2.5 text-left text-red-500 cursor-pointer">Archive</button>
                        </li>
                      </ul>
                    </td>
                    <td class="p-3"><%= company.name %></td>
                  </tr>
                <% } ) %>
              </tbody>
            </table>
          </div>
          <div class="border-t border-zinc-200">
            <div class="flex items-center justify-between gap-3">
              <div class="p-3 flex items-center gap-3">
                <% Array.from( { length: paginationTotal }, ( _, i ) => i + 1 ).slice( start, end ).forEach( ( v ) => { %>
                  <a href="<%= buildUrl( { page: v } ) %>" class="w-7.5 h-7.5 shrink-0 flex items-center justify-center text-center bg-zinc-100 rounded-md cursor-pointer"><%= v %></a>
                <% } ); %>
              </div>
              <div class="p-3 flex items-center gap-3">
                <% if ( page > 1 ) { %>
                  <a href="<%= buildUrl( { page: page - 1 } ) %>" class="px-3 py-1.5 bg-zinc-100 rounded-md cursor-pointer">Prev</a>
                <% } %>
                <% if ( page < paginationTotal ) { %>
                  <a href="<%= buildUrl( { page: page + 1 } ) %>" class="px-3 py-1.5 bg-zinc-100 rounded-md cursor-pointer">Next</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>

</html>