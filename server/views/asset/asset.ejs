<%
  const page = data.assetAssigns.page;
  const total = data.assetAssigns.total || 1;
  const limit = data.assetAssigns.limit;

  const paginationItems = 3;
  const paginationTotal = Math.ceil( total / limit );
  const coefficient = Math.ceil( page / paginationItems );
  const start = coefficient * paginationItems - paginationItems;
  const end = coefficient * paginationItems;
%>

<!DOCTYPE html>

<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <title><%= data.asset.name %></title>
    <meta name="title" content="Companies">
    <meta name="description" content="">
    <meta property="og:type" content="website">
    <meta property="og:title" content="">
    <meta property="og:description" content="">
    <meta property="og:image" content="">
    <meta property="og:url" content="">
    <meta name="twitter:image" content="">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme:light)">
    <meta name="theme-color" content="#18181b" media="(prefers-color-scheme:dark)">
    <link rel="icon" href="/images/favicon.svg" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon.svg">
    <link rel="stylesheet" href="/sources/main.css">
    <script src="/sources/main.js" defer></script>
  </head>

  <body class="text-xs text-zinc-700 bg-zinc-50 dark:text-zinc-400 dark:bg-zinc-900">
    <main>
      <section class="m-4 sm:m-10">
        <div class="mb-3 flex items-center gap-4">
          <h1 class="flex items-center gap-4 text-md sm:text-xl font-bold">
            <a href="/assetss" class="block w-10 h-10 bg-zinc-300 rounded-full flex items-center justify-center">
              <svg viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4">
                <path d="M9.61785 5.98595L11.5315 0.919794C11.7953 0.221241 10.8738 -0.322357 10.3482 0.221771L3.19002 7.63153C2.84466 7.98901 2.98974 8.57015 3.46604 8.73719L7.31537 10.0872C7.68274 10.2161 7.87215 10.6075 7.73845 10.9615L5.805 16.0801C5.53629 16.7914 6.49075 17.3321 7.00518 16.76L13.8268 9.17283C14.1517 8.81153 14.0001 8.24875 13.534 8.08525L10.0409 6.86016C9.67356 6.73135 9.48413 6.33994 9.61785 5.98595Z" fill="black"/>
              </svg>
            </a>
            <span><%= data.asset.name %></span>
          </h1>
          <button onclick="update_modal.showModal()" class="cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 stroke-zinc-300">
              <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
            </svg>
          </button>
          <dialog id="update_modal" class="modal">
            <div class="modal-box sm:min-w-4xl sm:min-h-[35rem] p-4 py-20 sm:px-20 sm:py-35 flex items-center justify-center bg-zinc-50 dark:bg-zinc-900">
              <div class="w-full">
                <h3 class="mb-5 text-xl text-center font-bold">Update asset</h3>
                <%- include( 'update-form', { body: { companies: data.companies.data, types: data.types.data, employees: data.employees.data, asset: data.asset } } ); %>
              </div>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
          <button onclick="delete_modal.showModal()" class="cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 stroke-zinc-300">
              <path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
          <dialog id="delete_modal" class="modal">
            <div class="modal-box sm:min-w-4xl sm:min-h-[35rem] p-4 py-20 sm:px-20 sm:py-35 flex items-center justify-center bg-zinc-50 dark:bg-zinc-900">
              <div class="w-full">
                <h3 class="mb-5 text-xl text-center font-bold">Delete <%= data.asset.name %></h3>
                <%- include( 'delete-form', { action: `${path}/delete` } ); %>
              </div>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
        </div>
        <div class="max-w-2xl mt-4 sm:mt-10 leading-[200%]">
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Alias molestias voluptatum eius ratione maxime ea, magni, nam voluptatibus beatae molestiae explicabo. Laudantium optio.</p>
        </div>
      </section>
      <section class="m-4 sm:m-10">
        <div class="border border-zinc-200 dark:border-zinc-800 rounded-md">
          <div class="border-b border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center">
              <div class="w-13.5 h-13.5 p-3"></div>
              <div class="p-3">
                <h2 class="font-bold">History</h2>
              </div>
            </div>
          </div>
          <div class="overflow-auto">
            <table class="w-full min-w-200 text-left table-fixed">
              <thead>
                <tr>
                  <th class="w-13.5 h-13.5"></th>
                  <th class="p-3">
                    <a href="<%= buildParams( { sort: 'employee', order: query.order === 'asc' ? 'desc' : 'asc' } ) %>" class="inline-flex items-center gap-1 cursor-pointer">
                      <span>Employee</span>
                      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                        <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                      </svg>
                    </a>
                  </th>
                  <th class="p-3">
                    <a href="<%= buildParams( { sort: 'startDate', order: query.order === 'asc' ? 'desc' : 'asc' } ) %>" class="inline-flex items-center gap-1 cursor-pointer">
                      <span>Start date</span>
                      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                        <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                      </svg>
                    </a>
                  </th>
                  <th class="p-3">
                    <a href="<%= buildParams( { sort: 'endDate', order: query.order === 'asc' ? 'desc' : 'asc' } ) %>" class="inline-flex items-center gap-1 cursor-pointer">
                      <span>End date</span>
                      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                        <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
                      </svg>
                    </a>
                  </th>
                </tr>
              </thead>
              <tbody>
                <% data.assetAssigns.data.forEach( asset => { %>
                  <tr class="border-t border-zinc-200 dark:border-zinc-800">
                    <td class="w-13.5 h-13.5 p-3"></td>
                    <td class="p-3"><%= asset.employee.name %></td>
                    <td class="p-3"><%= asset.startDate.toDateString() %></td>
                    <td class="p-3"><%= asset.endDate?.toDateString() %></td>
                  </tr>
                <% } ) %>
              </tbody>
            </table>
          </div>
          <div class="border-t border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center justify-between gap-3">
              <div class="p-3 flex items-center gap-3">
                <% Array.from( { length: paginationTotal }, ( _, i ) => i + 1 ).slice( start, end ).forEach( ( v ) => { %>
                  <a href="<%= buildParams( { page: v } ) %>" class="w-7.5 h-7.5 shrink-0 flex items-center justify-center text-center bg-zinc-100 dark:bg-zinc-800 rounded-md cursor-pointer"><%= v %></a>
                <% } ); %>
              </div>
              <div class="p-3 flex items-center gap-3">
                <% if ( page > 1 ) { %>
                  <a href="<%= buildParams( { page: page - 1 } ) %>" class="px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-md cursor-pointer">Prev</a>
                <% } %>
                <% if ( page < paginationTotal ) { %>
                  <a href="<%= buildParams( { page: page + 1 } ) %>" class="px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-md cursor-pointer">Next</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>

</html>