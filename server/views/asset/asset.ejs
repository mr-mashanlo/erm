<!DOCTYPE html>

<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <title><%= data.asset.name %></title>
    <meta name="title" content="Companies">
    <meta name="description" content="">
    <meta property="og:type" content="website">
    <meta property="og:title" content="">
    <meta property="og:description" content="">
    <meta property="og:image" content="">
    <meta property="og:url" content="">
    <meta name="twitter:image" content="">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/images/favicon.svg" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon.svg">
    <link rel="stylesheet" href="/sources/main.css">
    <script src="/sources/main.js" defer></script>
  </head>

  <body class="text-xs text-zinc-700 bg-zinc-50">
    <%- include( '../shared/header' ); %>
    <main>
      <section class="mx-4 my-8 sm:mx-10 sm:my-20">
        <div class="mb-3 flex items-center gap-4">
          <h1 class="text-xl sm:text-2xl font-semibold"><%= data.asset.name %></h1>
          <button onclick="update_modal.showModal()" class="cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 stroke-zinc-300">
              <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
            </svg>
          </button>
          <dialog id="update_modal" class="modal">
            <div class="modal-box min-w-3xl py-35 bg-zinc-50">
              <h3 class="mb-5 text-xl text-center font-bold">Update asset</h3>
              <%- // include( 'update-form', { body: { types: data.types.data } } ); %>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
          <button onclick="delete_modal.showModal()" class="cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 stroke-zinc-300">
              <path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
          <dialog id="delete_modal" class="modal">
            <div class="modal-box min-w-3xl py-35 bg-zinc-50">
              <h3 class="mb-5 text-xl text-center font-bold">Delete <%= data.asset.name %></h3>
              <%- include( 'delete-form', { action: `${path}/delete` } ); %>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>close</button>
            </form>
          </dialog>
        </div>
        <p class="max-w-2xl leading-[200%]">At tempore commodi quibusdam sed ea veritatis temporibus accusantium qui corporis obcaecati aperiam, eveniet, quisquam recusandae magni ducimus error possimus.</p>
      </section>
    </main>
  </body>

</html>