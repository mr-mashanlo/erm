generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  role String @default("ADMIN")
  refreshToken String?
  expiredAt BigInt?
  companies Company[]
  types Type[]
  assets Asset[]
}

model Company {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  user User @relation(fields: [userId], references: [id])
  userId String
  assets Asset[]
}

model Type {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  user User @relation(fields: [userId], references: [id])
  userId String
  assets Asset[]
}

model Asset {
  id String @id @default(cuid())
  name String
  slug String
  code String @unique
  user User @relation(fields: [userId], references: [id])
  userId String
  company Company @relation(fields: [companyId], references: [id])
  companyId String
  type Type @relation(fields: [typeId], references: [id])
  typeId String
}