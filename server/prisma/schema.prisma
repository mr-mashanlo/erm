generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role String @default("ADMIN")
  refreshToken String?
  expiredAt BigInt?
  companies Company[]
}

model Company {
  id Int @id @default(autoincrement())
  name String
  slug String
  user User @relation(fields: [userId], references: [id])
  userId Int
  type Type[]
  assets Asset[]
}

model Type {
  id Int @id @default(autoincrement())
  name String
  slug String
  company Company @relation(fields: [companyId], references: [id])
  companyId Int
  assets Asset[]
}

model Asset {
  id Int @id @default(autoincrement())
  name String
  slug String
  company Company @relation(fields: [companyId], references: [id])
  companyId Int
  type Type @relation(fields: [typeId], references: [id])
  typeId Int
}