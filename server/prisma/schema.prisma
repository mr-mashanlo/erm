generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  role String @default("ADMIN")
  refreshToken String?
  expiredAt BigInt?
  companies Company[]
  types Type[]
  assets Asset[]
  employee Employee[]
}

model Company {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  archived Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  userId String
  assets Asset[]
}

model Type {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  archived Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  userId String
  assets Asset[]
}

model Asset {
  id String @id @default(cuid())
  name String
  slug String
  code String @unique
  archived Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  userId String
  company Company @relation(fields: [companyId], references: [id])
  companyId String
  type Type @relation(fields: [typeId], references: [id])
  typeId String
  assetAssign AssetAssign[]
}

model Employee {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  archived Boolean @default(false)
  user User @relation(fields: [userId], references: [id])
  userId String
  assetAssign AssetAssign[]
}

model AssetAssign {
  id String @id @default(cuid())
  startDate DateTime @default(now())
  endDate DateTime?
  archived Boolean @default(false)
  asset Asset @relation(fields: [assetId], references: [id])
  assetId String
  employee Employee @relation(fields: [employeeId], references: [id])
  employeeId String
}